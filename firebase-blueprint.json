{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário da LibreOteca autenticado via Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "minLength": 2, "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150, "pattern": "^.+@.+\\..+$" },
        "role": { "type": "string", "enum": ["professor", "aluno"] },
        "matricula": { "type": "string", "maxLength": 50 },
        "turma": { "type": "string", "maxLength": 50 },
        "telefone": { "type": "string", "maxLength": 30 },
        "criado_em": { "type": "string", "maxLength": 50 },
        "avatar_cor": { "type": "string", "maxLength": 40 },
        "codigo_convite": { "type": "string", "maxLength": 100 }
      },
      "required": ["uid", "nome", "email", "role", "criado_em"]
    },
    "Livro": {
      "title": "Livro",
      "description": "Obra do acervo bibliográfico da biblioteca",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "codigo_interno": { "type": "string", "minLength": 3, "maxLength": 50 },
        "isbn": { "type": "string", "maxLength": 20 },
        "titulo": { "type": "string", "minLength": 1, "maxLength": 200 },
        "autor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "categoria": { "type": "string", "minLength": 1, "maxLength": 100 },
        "capa_url": { "type": "string", "maxLength": 500 },
        "total_exemplares": { "type": "integer" },
        "disponiveis": { "type": "integer" },
        "ano_publicacao": { "type": "integer" },
        "paginas": { "type": "integer" },
        "editora": { "type": "string", "maxLength": 100 },
        "sinopse": { "type": "string", "maxLength": 2000 },
        "criado_em": { "type": "string", "maxLength": 50 }
      },
      "required": ["codigo_interno", "titulo", "autor", "categoria", "total_exemplares", "disponiveis", "criado_em"]
    },
    "Leitor": {
      "title": "Leitor",
      "description": "Registro cadastral de usuário leitor (aluno, professor ou comunidade) protegido por LGPD",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "minLength": 2, "maxLength": 150 },
        "matricula": { "type": "string", "minLength": 2, "maxLength": 50 },
        "telefone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "tipo": { "type": "string", "enum": ["aluno", "professor", "comunidade", "funcionario"] },
        "ativo": { "type": "boolean" },
        "anonimizado": { "type": "boolean" },
        "criado_em": { "type": "string", "maxLength": 50 },
        "observacoes": { "type": "string", "maxLength": 500 }
      },
      "required": ["nome", "matricula", "tipo", "ativo", "criado_em"]
    },
    "Emprestimo": {
      "title": "Emprestimo",
      "description": "Registro de empréstimo e devolução de livro",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "livro_id": { "type": "string", "maxLength": 128 },
        "leitor_id": { "type": "string", "maxLength": 128 },
        "usuario_id": { "type": "string", "maxLength": 128 },
        "emprestado_em": { "type": "string", "maxLength": 30 },
        "devolucao_prevista": { "type": "string", "maxLength": 30 },
        "devolvido_em": { "type": "string", "maxLength": 30 },
        "renovacoes": { "type": "integer" },
        "observacao": { "type": "string", "maxLength": 500 }
      },
      "required": ["livro_id", "leitor_id", "emprestado_em", "devolucao_prevista", "renovacoes"]
    },
    "ComentarioLivro": {
      "title": "ComentarioLivro",
      "description": "Avaliação e resenha literária moderada feita por leitores",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "livro_id": { "type": "string", "maxLength": 128 },
        "leitor_id": { "type": "string", "maxLength": 128 },
        "autor_nome": { "type": "string", "maxLength": 150 },
        "autor_tipo": { "type": "string", "maxLength": 50 },
        "nota": { "type": "integer" },
        "texto": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "criado_em": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["aprovado", "bloqueado_filtro", "removido_professor"] },
        "motivo_bloqueio": { "type": "string", "maxLength": 200 },
        "termo_bloqueado": { "type": "string", "maxLength": 100 },
        "curtidas": { "type": "integer" }
      },
      "required": ["livro_id", "leitor_id", "autor_nome", "nota", "texto", "criado_em", "status"]
    },
    "Configuracoes": {
      "title": "Configuracoes",
      "description": "Parâmetros gerais de operação da biblioteca",
      "type": "object",
      "properties": {
        "nome_biblioteca": { "type": "string", "maxLength": 150 },
        "tipo_instituicao": { "type": "string", "enum": ["escola", "publica", "comunitaria", "universitaria"] },
        "prazo_padrao_dias": { "type": "integer" },
        "limite_emprestimos_por_leitor": { "type": "integer" },
        "bloquear_leitor_com_atraso": { "type": "boolean" },
        "permitir_renovacao_com_atraso": { "type": "boolean" }
      },
      "required": ["nome_biblioteca", "prazo_padrao_dias", "limite_emprestimos_por_leitor"]
    },
    "AdminsConfig": {
      "title": "AdminsConfig",
      "description": "Configurações confidenciais e códigos mestres acessíveis apenas por super administradores",
      "type": "object",
      "properties": {
        "codigo_mestre_professor": { "type": "string", "maxLength": 100 }
      },
      "required": ["codigo_mestre_professor"]
    },
    "Auditoria": {
      "title": "Auditoria",
      "description": "Registro imutável de auditoria e rastreabilidade LGPD",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "usuario_id": { "type": "string", "maxLength": 128 },
        "usuario_nome": { "type": "string", "maxLength": 150 },
        "acao": { "type": "string", "maxLength": 100 },
        "tabela_afetada": { "type": "string", "enum": ["livros", "leitores", "emprestimos", "configuracoes"] },
        "registro_id": { "type": "string", "maxLength": 128 },
        "detalhes": { "type": "string", "maxLength": 1000 },
        "criado_em": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "usuario_id", "usuario_nome", "acao", "tabela_afetada", "detalhes", "criado_em"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Documentos dos usuários cadastrados"
    },
    "/livros/{livroId}": {
      "schema": "Livro",
      "description": "Catálogo de livros da biblioteca"
    },
    "/leitores/{leitorId}": {
      "schema": "Leitor",
      "description": "Cadastro de leitores da biblioteca protegido por LGPD"
    },
    "/emprestimos/{emprestimoId}": {
      "schema": "Emprestimo",
      "description": "Movimentações de empréstimos e devoluções"
    },
    "/comentarios/{comentarioId}": {
      "schema": "ComentarioLivro",
      "description": "Comentários e resenhas das obras"
    },
    "/configuracoes/{configId}": {
      "schema": "Configuracoes",
      "description": "Configurações institucionais da biblioteca"
    },
    "/admins_config/{configId}": {
      "schema": "AdminsConfig",
      "description": "Configurações confidenciais e códigos mestres acessíveis apenas por super administradores"
    },
    "/auditoria/{auditoriaId}": {
      "schema": "Auditoria",
      "description": "Trilha de auditoria imutável LGPD"
    }
  }
}
