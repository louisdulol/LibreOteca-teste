rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GLOBAL CATCH-ALL: NEGAR TUDO POR PADRÃO (ZERO-TRUST)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPER FUNCTIONS — PRIMITIVAS DE SEGURANÇA E PAPÉIS (RBAC)
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Super Admin com privilégios verificados
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lipizinjiga14@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Verificação de papel de Professor / Bibliotecário no documento confiável do Firestore
    function isProfessor() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'professor'
      );
    }

    // ===============================================================
    // VALIDADORES DE ESQUEMA (BLUEPRINTS)
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'nome', 'email', 'role', 'criado_em']) &&
        data.keys().hasOnly(['id', 'uid', 'nome', 'email', 'role', 'matricula', 'turma', 'telefone', 'criado_em', 'avatar_cor', 'senhaHash']) &&
        data.id is string && data.id.size() <= 128 &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 150 &&
        data.email is string && data.email.size() <= 150 &&
        data.role in ['professor', 'aluno'] &&
        data.criado_em is string && data.criado_em.size() <= 50;
    }

    function isValidLivro(data) {
      return data.keys().hasAll(['codigo_interno', 'titulo', 'autor', 'categoria', 'total_exemplares', 'disponiveis', 'criado_em']) &&
        data.keys().hasOnly(['id', 'codigo_interno', 'isbn', 'titulo', 'autor', 'categoria', 'capa_url', 'total_exemplares', 'disponiveis', 'ano_publicacao', 'paginas', 'editora', 'sinopse', 'criado_em']) &&
        data.codigo_interno is string && data.codigo_interno.size() >= 3 && data.codigo_interno.size() <= 50 &&
        data.titulo is string && data.titulo.size() >= 1 && data.titulo.size() <= 200 &&
        data.autor is string && data.autor.size() >= 1 && data.autor.size() <= 200 &&
        data.categoria is string && data.categoria.size() >= 1 && data.categoria.size() <= 100 &&
        data.total_exemplares is int && data.total_exemplares >= 0 &&
        data.disponiveis is int && data.disponiveis >= 0 && data.disponiveis <= data.total_exemplares &&
        data.criado_em is string && data.criado_em.size() <= 50;
    }

    function isValidLeitor(data) {
      return data.keys().hasAll(['nome', 'matricula', 'tipo', 'ativo', 'criado_em']) &&
        data.keys().hasOnly(['id', 'nome', 'matricula', 'telefone', 'email', 'tipo', 'ativo', 'anonimizado', 'criado_em', 'observacoes']) &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 150 &&
        data.matricula is string && data.matricula.size() >= 2 && data.matricula.size() <= 50 &&
        data.tipo in ['aluno', 'professor', 'comunidade', 'funcionario'] &&
        data.ativo is bool &&
        data.criado_em is string && data.criado_em.size() <= 50;
    }

    function isValidEmprestimo(data) {
      return data.keys().hasAll(['livro_id', 'leitor_id', 'emprestado_em', 'devolucao_prevista', 'renovacoes']) &&
        data.keys().hasOnly(['id', 'livro_id', 'leitor_id', 'emprestado_em', 'devolucao_prevista', 'devolvido_em', 'renovacoes', 'observacao']) &&
        data.livro_id is string && data.livro_id.size() <= 128 &&
        data.leitor_id is string && data.leitor_id.size() <= 128 &&
        data.emprestado_em is string && data.emprestado_em.size() <= 30 &&
        data.devolucao_prevista is string && data.devolucao_prevista.size() <= 30 &&
        data.renovacoes is int && data.renovacoes >= 0;
    }

    function isValidComentario(data) {
      return data.keys().hasAll(['livro_id', 'leitor_id', 'autor_nome', 'nota', 'texto', 'criado_em', 'status']) &&
        data.keys().hasOnly(['id', 'livro_id', 'leitor_id', 'autor_nome', 'autor_tipo', 'nota', 'texto', 'criado_em', 'status', 'motivo_bloqueio', 'termo_bloqueado', 'curtidas']) &&
        data.livro_id is string && data.livro_id.size() <= 128 &&
        data.leitor_id is string && data.leitor_id.size() <= 128 &&
        data.autor_nome is string && data.autor_nome.size() <= 150 &&
        data.nota is int && data.nota >= 1 && data.nota <= 5 &&
        data.texto is string && data.texto.size() >= 1 && data.texto.size() <= 1000 &&
        data.status in ['aprovado', 'bloqueado_filtro', 'removido_professor'] &&
        data.criado_em is string && data.criado_em.size() <= 50;
    }

    function isValidConfiguracao(data) {
      return data.keys().hasAll(['nome_biblioteca', 'prazo_padrao_dias', 'limite_emprestimos_por_leitor']) &&
        data.keys().hasOnly(['nome_biblioteca', 'tipo_instituicao', 'prazo_padrao_dias', 'limite_emprestimos_por_leitor', 'bloquear_leitor_com_atraso', 'permitir_renovacao_com_atraso', 'codigo_mestre_professor']) &&
        data.nome_biblioteca is string && data.nome_biblioteca.size() <= 150 &&
        data.prazo_padrao_dias is int && data.prazo_padrao_dias >= 1 && data.prazo_padrao_dias <= 90 &&
        data.limite_emprestimos_por_leitor is int && data.limite_emprestimos_por_leitor >= 1 && data.limite_emprestimos_por_leitor <= 20;
    }

    function isValidAuditoria(data) {
      return data.keys().hasAll(['id', 'usuario_id', 'usuario_nome', 'acao', 'tabela_afetada', 'detalhes', 'criado_em']) &&
        data.keys().hasOnly(['id', 'usuario_id', 'usuario_nome', 'acao', 'tabela_afetada', 'registro_id', 'detalhes', 'criado_em']) &&
        data.id is string && data.id.size() <= 128 &&
        data.usuario_id is string && data.usuario_id.size() <= 128 &&
        data.usuario_nome is string && data.usuario_nome.size() <= 150 &&
        data.acao is string && data.acao.size() <= 100 &&
        data.tabela_afetada in ['livros', 'leitores', 'emprestimos', 'configuracoes'] &&
        data.detalhes is string && data.detalhes.size() <= 1000 &&
        data.criado_em is string && data.criado_em.size() <= 50;
    }

    // ===============================================================
    // COLEÇÃO: USERS (PERFIS E CREDENCIAIS)
    // ===============================================================
    match /users/{userId} {
      // Leitura permitida apenas para o próprio usuário ou professor/admin
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isProfessor());
      // Listagem completa de usuários restrita a professores/administradores
      allow list: if isProfessor();

      // Criação de perfil: próprio usuário cadastrando-se
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidUser(incoming()) &&
        (
          incoming().role in ['aluno', 'professor']
        );

      // Atualização de perfil: dados pessoais editáveis, mas BLOQUEIO de auto-escalação de papel
      allow update: if isValidId(userId) &&
        isSignedIn() &&
        (request.auth.uid == userId || isProfessor()) &&
        isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().criado_em == existing().criado_em &&
        (
          // Usuário comum não pode mudar seu próprio role
          incoming().role == existing().role ||
          isSuperAdmin()
        );

      // Exclusão permitida apenas a super admin
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    // ===============================================================
    // COLEÇÃO: LIVROS (ACERVO BIBLIOGRÁFICO)
    // ===============================================================
    match /livros/{livroId} {
      // Catálogo público: leitura livre para alunos, professores e comunidade
      allow read: if true;

      // Gestão de acervo: estritamente restrita a professores/administradores
      allow create: if isValidId(livroId) && isProfessor() && isValidLivro(incoming());
      allow update: if isValidId(livroId) && isProfessor() && isValidLivro(incoming()) &&
        incoming().id == existing().id &&
        incoming().criado_em == existing().criado_em;
      allow delete: if isValidId(livroId) && isProfessor();
    }

    // ===============================================================
    // COLEÇÃO: LEITORES (CADASTRO LGPD)
    // ===============================================================
    match /leitores/{leitorId} {
      // Consulta individual: professor ou o próprio leitor autenticado
      allow get: if isValidId(leitorId) && (
        isProfessor() ||
        (isSignedIn() && (
          request.auth.uid == leitorId ||
          (resource.data.email != null && resource.data.email == request.auth.token.email && request.auth.token.email_verified == true)
        ))
      );

      // Listagem geral: ESTRITAMENTE restrita a professores (proibido scraping público de dados pessoais)
      allow list: if isProfessor();

      // Mutações: apenas professores/administradores da biblioteca
      allow create: if isValidId(leitorId) && isProfessor() && isValidLeitor(incoming());
      allow update: if isValidId(leitorId) && isProfessor() && isValidLeitor(incoming()) &&
        incoming().id == existing().id &&
        incoming().criado_em == existing().criado_em;
      allow delete: if isValidId(leitorId) && isProfessor();
    }

    // ===============================================================
    // COLEÇÃO: EMPRESTIMOS (CIRCULAÇÃO E DEVOLUÇÕES)
    // ===============================================================
    match /emprestimos/{emprestimoId} {
      // Consulta individual: professor ou o leitor titular do empréstimo
      allow get: if isValidId(emprestimoId) && (
        isProfessor() ||
        (isSignedIn() && resource.data.leitor_id == request.auth.uid)
      );

      // Listagem: professores veem todos; leitor autenticado vê apenas os seus
      allow list: if isProfessor() || (
        isSignedIn() && resource.data.leitor_id == request.auth.uid
      );

      // Criação: apenas professor, com garantia relacional (livro e leitor devem existir)
      allow create: if isValidId(emprestimoId) &&
        isProfessor() &&
        isValidEmprestimo(incoming()) &&
        exists(/databases/$(database)/documents/livros/$(incoming().livro_id)) &&
        exists(/databases/$(database)/documents/leitores/$(incoming().leitor_id));

      // Atualização (devolução, renovação): apenas professor
      allow update: if isValidId(emprestimoId) &&
        isProfessor() &&
        isValidEmprestimo(incoming()) &&
        incoming().id == existing().id &&
        incoming().livro_id == existing().livro_id &&
        incoming().leitor_id == existing().leitor_id;

      // Exclusão: apenas professor
      allow delete: if isValidId(emprestimoId) && isProfessor();
    }

    // ===============================================================
    // COLEÇÃO: COMENTARIOS (RESENHAS E AVALIAÇÕES LITERÁRIAS)
    // ===============================================================
    match /comentarios/{comentarioId} {
      // Leitura: comentários aprovados são públicos; pendentes/bloqueados apenas pelo autor ou professor
      allow get: if isValidId(comentarioId) && (
        resource.data.status == 'aprovado' ||
        isProfessor() ||
        (isSignedIn() && resource.data.leitor_id == request.auth.uid)
      );

      allow list: if resource.data.status == 'aprovado' ||
        isProfessor() ||
        (isSignedIn() && resource.data.leitor_id == request.auth.uid);

      // Criação: usuário autenticado criando resenha para si mesmo, garantindo existência do livro
      allow create: if isValidId(comentarioId) &&
        isSignedIn() &&
        incoming().leitor_id == request.auth.uid &&
        isValidComentario(incoming()) &&
        incoming().status in ['aprovado', 'bloqueado_filtro'] &&
        exists(/databases/$(database)/documents/livros/$(incoming().livro_id));

      // Atualização: autor pode atualizar texto/nota; professor pode moderar status
      allow update: if isValidId(comentarioId) && (
        (
          // Moderação pelo professor
          isProfessor() &&
          isValidComentario(incoming()) &&
          incoming().id == existing().id &&
          incoming().livro_id == existing().livro_id &&
          incoming().leitor_id == existing().leitor_id
        ) ||
        (
          // Edição pelo autor titular
          isSignedIn() &&
          request.auth.uid == existing().leitor_id &&
          isValidComentario(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['texto', 'nota'])
        )
      );

      // Exclusão: autor da resenha ou professor
      allow delete: if isValidId(comentarioId) && (
        (isSignedIn() && request.auth.uid == existing().leitor_id) ||
        isProfessor()
      );
    }

    // ===============================================================
    // COLEÇÃO: CONFIGURAÇÕES (PARÂMETROS DA BIBLIOTECA)
    // ===============================================================
    match /configuracoes/{configId} {
      // Leitura pública dos parâmetros de funcionamento da biblioteca
      allow read: if isValidId(configId);

      // Alteração restrita a professores
      allow write: if isValidId(configId) && isProfessor() && isValidConfiguracao(incoming());
    }

    // ===============================================================
    // COLEÇÃO: AUDITORIA (TRILHA IMUTÁVEL LGPD)
    // ===============================================================
    match /auditoria/{auditoriaId} {
      // Consulta restrita a professores/administradores
      allow read: if isValidId(auditoriaId) && isProfessor();

      // Registro permitido a qualquer usuário autenticado registrando sua própria ação
      allow create: if isValidId(auditoriaId) &&
        isSignedIn() &&
        incoming().usuario_id == request.auth.uid &&
        isValidAuditoria(incoming());

      // IMUTABILIDADE: Auditoria nunca pode ser editada nem apagada por ninguém
      allow update, delete: if false;
    }

    // ===============================================================
    // COLEÇÃO: ADMINS (CONTROLE DE ACESSO CRÍTICO)
    // ===============================================================
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Gerenciado exclusivamente no console de nuvem
    }
  }
}
